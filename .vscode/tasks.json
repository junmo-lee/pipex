{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make fclean",
            "type": "shell",
            "command": "make",
            "args": ["-j4", "fclean"],
            "group": {
                "kind": "none",
                "isDefault": true
            },
            "options": {
				"cwd": "${workspaceFolder}"
			},
            "problemMatcher": []
        },
        {
            "label": "Build : Debug bonus",
            "type": "shell",
            "command": "make",
			"args": ["-j4", "debug_bonus", "DEBUG_FLAG=1", "IGNORE_ERROR=1"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
			"options": {
				"cwd": "${workspaceFolder}"
			},
            "dependsOn": ["make fclean"]
        },
		{
            "label": "Build : Debug Mandatory",
            "type": "shell",
            "command": "make",
			"args": ["-j4", "debug", "DEBUG_FLAG=1", "IGNORE_ERROR=1"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
			"options": {
				"cwd": "${workspaceFolder}"
			},
            "dependsOn": ["make fclean"]
        }
    ]
}